<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="gclo.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel MinWidth="420" Spacing="12">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="TargetFolderBox"
                Header="Default target folder"
                PlaceholderText="C:\src\my-org"
                ToolTipService.ToolTip="Pre-filled as the sync target for new workspaces" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Content="Browse…"
                AutomationProperties.AutomationId="SettingsBrowseButton"
                ToolTipService.ToolTip="Choose the default target folder"
                Click="BrowseButton_Click" />
        </Grid>
        <!-- Default tokens (#212): one for GitHub, one for a Gitea server, named as
             everywhere else. Each belongs to its place and is used for no other. -->
        <StackPanel Spacing="2">
            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Default tokens" />
            <TextBlock
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Text="Quick Sync fills in the default token of the place it is on, and an account can use the one of its place. Stored in Windows Credential Manager, never in a file." />
        </StackPanel>
        <PasswordBox
            x:Name="DefaultTokenBox"
            Header="GitHub"
            AutomationProperties.AutomationId="SettingsDefaultTokenBox"
            PlaceholderText="ghp_…"
            ToolTipService.ToolTip="The default token for GitHub: pre-fills Quick Sync when it is on GitHub and serves every GitHub account set to use it."
            PasswordChanged="DefaultTokenBox_PasswordChanged" />
        <!-- Caption takes the width, the Remove link keeps its own: a horizontal
             StackPanel clipped the link once the caption grew (#101). -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TokenStateText"
                Grid.Column="0"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Polite"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <HyperlinkButton
                x:Name="RemoveTokenButton"
                Grid.Column="1"
                Padding="0"
                VerticalAlignment="Center"
                Content="Remove saved token"
                ToolTipService.ToolTip="Clears the box; the saved default token is deleted from Windows Credential Manager when you press Save"
                Click="RemoveTokenButton_Click" />
        </Grid>
        <!-- Gitea: the token is for one server, so the address and the token are
             saved, replaced and removed together. -->
        <TextBox
            x:Name="GiteaServerBox"
            Header="Gitea"
            AutomationProperties.AutomationId="SettingsGiteaServerBox"
            PlaceholderText="Server address, like https://git.example.com"
            ToolTipService.ToolTip="The address of the Gitea (or Forgejo) server the default token below is for. HTTPS only; the token is used for this server and no other."
            TextChanged="GiteaServerBox_TextChanged" />
        <PasswordBox
            x:Name="GiteaTokenBox"
            AutomationProperties.AutomationId="SettingsGiteaTokenBox"
            AutomationProperties.Name="Default token for the Gitea server"
            PlaceholderText="Access token of that server"
            ToolTipService.ToolTip="The default token for the Gitea server above: pre-fills Quick Sync when it is on that server and serves every account on it that is set to use the default token."
            PasswordChanged="GiteaTokenBox_PasswordChanged" />
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="GiteaStateText"
                Grid.Column="0"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                AutomationProperties.AutomationId="SettingsGiteaStateText"
                AutomationProperties.LiveSetting="Polite"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <HyperlinkButton
                x:Name="RemoveGiteaTokenButton"
                Grid.Column="1"
                Padding="0"
                VerticalAlignment="Center"
                Content="Remove saved token"
                ToolTipService.ToolTip="Clears the box; the saved default token is deleted from Windows Credential Manager when you press Save"
                Click="RemoveGiteaTokenButton_Click" />
        </Grid>
        <NumberBox
            x:Name="ConcurrencyBox"
            Header="Default parallelism"
            Minimum="1"
            Maximum="64"
            SmallChange="1"
            SpinButtonPlacementMode="Inline"
            ToolTipService.ToolTip="How many repositories new workspaces clone or pull at the same time" />
        <ComboBox
            x:Name="ThemeBox"
            HorizontalAlignment="Stretch"
            Header="Theme"
            ToolTipService.ToolTip="Light, dark, or follow the Windows setting">
            <ComboBoxItem Content="System" />
            <ComboBoxItem Content="Light" />
            <ComboBoxItem Content="Dark" />
        </ComboBox>
        <Expander
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Header="Advanced">
            <StackPanel Spacing="12">
                <ToggleSwitch
                    x:Name="SplashToggle"
                    Header="Show splash screen at startup"
                    AutomationProperties.AutomationId="SettingsSplashToggle"
                    ToolTipService.ToolTip="Turns the branded startup splash on or off" />
                <NumberBox
                    x:Name="SplashDurationBox"
                    Header="Splash duration (milliseconds)"
                    Minimum="500"
                    Maximum="30000"
                    SmallChange="250"
                    SpinButtonPlacementMode="Inline"
                    AutomationProperties.AutomationId="SettingsSplashDurationBox"
                    ToolTipService.ToolTip="How long the splash stays on screen before fading (500–30000 ms)" />
            </StackPanel>
        </Expander>
    </StackPanel>
</ContentDialog>
