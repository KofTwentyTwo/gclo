<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="gclo.WorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:gclo"
    xmlns:vm="using:gclo.ViewModels"
    xmlns:tv="using:WinUI.TableView"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- The per-column funnel that opens that column's filter flyout; it lives
             inside the TableView column header, beside the header text. -->
        <Style x:Key="ColumnFilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Column widths of the repository table, declared once. -->
        <GridLength x:Key="SelectColumnWidth">40</GridLength>
        <GridLength x:Key="NameColumnWidth">2*</GridLength>
        <GridLength x:Key="StatusColumnWidth">160</GridLength>
        <GridLength x:Key="BranchColumnWidth">120</GridLength>
        <GridLength x:Key="ArchivedColumnWidth">96</GridLength>
        <!-- Header automation names are set from code (sort state is composed in), but
             every header needs a sensible name before the first sort; one style per
             column since Style setters cannot bind. -->
        <Style x:Key="SelectHeaderStyle" TargetType="tv:TableViewColumnHeader">
            <Setter Property="AutomationProperties.Name" Value="Select" />
        </Style>
        <Style x:Key="NameHeaderStyle" TargetType="tv:TableViewColumnHeader">
            <Setter Property="AutomationProperties.Name" Value="Name, not sorted" />
        </Style>
        <Style x:Key="StatusHeaderStyle" TargetType="tv:TableViewColumnHeader">
            <Setter Property="AutomationProperties.Name" Value="Status, not sorted" />
        </Style>
        <Style x:Key="BranchHeaderStyle" TargetType="tv:TableViewColumnHeader">
            <Setter Property="AutomationProperties.Name" Value="Branch, not sorted" />
        </Style>
        <Style x:Key="ArchivedHeaderStyle" TargetType="tv:TableViewColumnHeader">
            <Setter Property="AutomationProperties.Name" Value="Archived, not sorted" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <!-- Driven by UpdateToolbarLayout (measured widths, not window width, so
                 text scaling and localization count too). The markup default is the
                 narrow two-row toolbar; this state lifts the action buttons back
                 beside the filter bar when everything fits on one row. -->
            <VisualStateGroup x:Name="ToolbarLayoutStates">
                <VisualState x:Name="ToolbarTwoRow" />
                <VisualState x:Name="ToolbarSingleRow">
                    <VisualState.Setters>
                        <Setter Target="IdleActions.(Grid.Row)" Value="0" />
                        <Setter Target="IdleActions.(Grid.Column)" Value="2" />
                        <Setter Target="IdleActions.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="IdleActions.Margin" Value="0" />
                        <Setter Target="RunningActions.(Grid.Row)" Value="0" />
                        <Setter Target="RunningActions.(Grid.Column)" Value="2" />
                        <Setter Target="RunningActions.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="RunningActions.Margin" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Failed load / organization lookup. Lives outside both states so a first
             load that fails (connect card still showing) and a refresh that fails
             (table showing) get the same red, dismissable surface with a Retry — not
             caption text at the bottom of the window. -->
        <InfoBar
            Grid.Row="0"
            AutomationProperties.AutomationId="LoadErrorBar"
            Severity="Error"
            IsOpen="{x:Bind ViewModel.LoadErrorOpen, Mode=TwoWay}"
            Title="{x:Bind ViewModel.LoadErrorTitle, Mode=OneWay}"
            Message="{x:Bind ViewModel.LoadErrorMessage, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button
                    AutomationProperties.AutomationId="LoadErrorRetryButton"
                    Content="Retry"
                    Command="{x:Bind ViewModel.LoadReposCommand, Mode=OneTime}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- ============================================================ State 1
             Connect card, shown until the first successful load in this workspace. -->
        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind local:StatusFormat.VisibleIfNot(ViewModel.HasLoadedRepos), Mode=OneWay}">
            <Border
                MaxWidth="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Connect to GitHub" />

                    <local:ConnectionFormControl
                        x:Name="ConnectForm"
                        AutomationIdPrefix="Connect"
                        IsEnabled="{x:Bind ViewModel.CanEditInputs, Mode=OneWay}"
                        ViewModel="{x:Bind ViewModel, Mode=OneTime}" />

                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="Once this connection works, save it as an account (Edit on the connection chip) so the token is kept for you."
                        Visibility="{x:Bind local:StatusFormat.VisibleIfNot(IsAccountWorkspace), Mode=OneTime}" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            MinWidth="140"
                            AutomationProperties.AutomationId="LoadReposButton"
                            ToolTipService.ToolTip="List every repository the token can see in this organization"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="Load repositories"
                            Command="{x:Bind ViewModel.LoadReposCommand, Mode=OneTime}">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="R" Modifiers="Control" />
                            </Button.KeyboardAccelerators>
                        </Button>
                        <ProgressRing
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Loading repositories"
                            IsActive="{x:Bind ViewModel.IsLoadingRepos, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ============================================================ State 2
             Connection chip + hero table card, once repositories have loaded. -->
        <Grid
            Grid.Row="1"
            RowSpacing="12"
            Visibility="{x:Bind local:StatusFormat.VisibleIf(ViewModel.HasLoadedRepos), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Connection chip: what this workspace is connected to, and where clones land. -->
            <Border
                Grid.Row="0"
                HorizontalAlignment="Left"
                Padding="12,6"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontSize="14"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Glyph="&#xE77B;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.Organization, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="·" />
                    <TextBlock
                        x:Name="ChipRepoCountText"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="·" />
                    <TextBlock
                        MaxWidth="280"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind ViewModel.EffectiveTargetRoot, Mode=OneWay}"
                        Text="{x:Bind ViewModel.EffectiveTargetRoot, Mode=OneWay}" />
                    <HyperlinkButton
                        Padding="4,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ChipEditButton"
                        AutomationProperties.Name="Edit connection"
                        Content="Edit"
                        Click="EditButton_Click">
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="EditFlyout" Placement="Bottom">
                                <StackPanel Width="360" Spacing="12">
                                    <!-- Account workspace: the connection is the saved profile; the one
                                         visible Edit affordance must lead to the wizard that edits it. -->
                                    <StackPanel
                                        Spacing="12"
                                        Visibility="{x:Bind local:StatusFormat.VisibleIf(IsAccountWorkspace), Mode=OneTime}">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            Text="This workspace is a saved account. Its token, organization, folder, and parallelism are edited in the account wizard." />
                                        <Button
                                            AutomationProperties.AutomationId="ChipEditAccountButton"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Content="Edit account…"
                                            IsEnabled="{x:Bind ViewModel.CanEditInputs, Mode=OneWay}"
                                            Click="EditAccountButton_Click" />
                                    </StackPanel>
                                    <StackPanel
                                        Spacing="12"
                                        Visibility="{x:Bind local:StatusFormat.VisibleIfNot(IsAccountWorkspace), Mode=OneTime}">
                                        <local:ConnectionFormControl
                                            x:Name="EditForm"
                                            AutomationIdPrefix="Edit"
                                            IsEnabled="{x:Bind ViewModel.CanEditInputs, Mode=OneWay}"
                                            ViewModel="{x:Bind ViewModel, Mode=OneTime}" />
                                        <!-- The bridge from a working ad-hoc setup to a saved account:
                                             the wizard opens seeded with everything above. -->
                                        <Button
                                            AutomationProperties.AutomationId="ChipSaveAsAccountButton"
                                            Content="Save as account…"
                                            ToolTipService.ToolTip="Keep this token, organization, and folder as a named account in the navigation pane"
                                            Click="SaveAsAccountButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </HyperlinkButton>
                </StackPanel>
            </Border>

            <!-- The organization was edited after the load: the rows no longer match the
                 chip and target path, so syncing is blocked until a reload. Not closable;
                 it goes away by reloading (or by putting the organization back). -->
            <InfoBar
                Grid.Row="1"
                AutomationProperties.AutomationId="StaleTableBar"
                Severity="Warning"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsTableStale, Mode=OneWay}"
                Title="Organization changed"
                Message="{x:Bind ViewModel.StaleTableMessage, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button
                        AutomationProperties.AutomationId="StaleTableReloadButton"
                        Content="Reload repositories"
                        Command="{x:Bind ViewModel.LoadReposCommand, Mode=OneTime}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Hero table card: toolbar, active strip, results InfoBar, header, rows. -->
            <Grid
                Grid.Row="2"
                Padding="12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Toolbar: filter | selection summary (trims) | options / refresh / sync,
                     with the right side swapping to live progress + Cancel while running.
                     The XAML default is the narrow layout (actions on their own row); the
                     ToolbarSingleRow visual state lifts them beside the filter when the
                     measured widths fit — see UpdateToolbarLayout, which responds to any
                     width pressure (window size, text scaling, localization). -->
                <Grid
                    x:Name="ToolbarGrid"
                    Grid.Row="0"
                    ColumnSpacing="12"
                    SizeChanged="Toolbar_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <SelectorBar
                        x:Name="FilterSelectorBar"
                        AutomationProperties.AutomationId="RepoFilterBar"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        SelectionChanged="FilterSelectorBar_SelectionChanged">
                        <SelectorBarItem x:Name="FilterAllItem" Text="All" Tag="All" ToolTipService.ToolTip="Show every loaded repository" />
                        <SelectorBarItem Text="Active" Tag="Active" ToolTipService.ToolTip="Show repositories cloning or pulling right now" />
                        <SelectorBarItem Text="Failed" Tag="Failed" ToolTipService.ToolTip="Show repositories whose last run failed" />
                        <SelectorBarItem Text="Pending" Tag="Pending" ToolTipService.ToolTip="Show repositories still waiting to run" />
                    </SelectorBar>
                    <TextBlock
                        x:Name="SelectionSummaryText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel
                        x:Name="IdleActions"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8"
                        SizeChanged="Toolbar_SizeChanged"
                        Visibility="{x:Bind local:StatusFormat.VisibleIfNot(ViewModel.IsRunning), Mode=OneWay}">
                        <Button
                            x:Name="OptionsButton"
                            AutomationProperties.AutomationId="SyncOptionsButton"
                            AutomationProperties.Name="Sync options"
                            ToolTipService.ToolTip="Sync options">
                            <FontIcon FontSize="16" Glyph="&#xE713;" />
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <ContentControl
                                        HorizontalContentAlignment="Stretch"
                                        IsEnabled="{x:Bind ViewModel.CanEditInputs, Mode=OneWay}"
                                        IsTabStop="False">
                                    <StackPanel Width="320" Spacing="12">
                                        <NumberBox
                                            Header="Parallel clones"
                                            Minimum="1"
                                            Maximum="64"
                                            SpinButtonPlacementMode="Inline"
                                            ToolTipService.ToolTip="How many repositories are cloned or pulled at the same time"
                                            Value="{x:Bind ViewModel.MaxConcurrencyValue, Mode=TwoWay}" />
                                        <CheckBox
                                            MinWidth="0"
                                            Content="{x:Bind OrgSubfolderLabel(ViewModel.Organization), Mode=OneWay}"
                                            IsChecked="{x:Bind ViewModel.CreateOrgSubfolder, Mode=TwoWay}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind local:StatusFormat.VisibleIfNotEmpty(ViewModel.TargetPreview), Mode=OneWay}">
                                            <Run Text="Each repository will be placed at:" />
                                            <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.TargetPreview, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    </ContentControl>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button
                            AutomationProperties.AutomationId="RefreshButton"
                            Content="Refresh"
                            ToolTipService.ToolTip="Reload the repository list from GitHub (Ctrl+R)"
                            Command="{x:Bind ViewModel.LoadReposCommand, Mode=OneTime}">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="R" Modifiers="Control" />
                            </Button.KeyboardAccelerators>
                        </Button>
                        <Button
                            MinWidth="120"
                            AutomationProperties.AutomationId="SyncButton"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Clone new repositories and update existing ones, for the selected rows (Ctrl+Enter)"
                            Content="{x:Bind ViewModel.SyncButtonLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SyncCommand, Mode=OneTime}">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </StackPanel>
                    <StackPanel
                        x:Name="RunningActions"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8"
                        SizeChanged="Toolbar_SizeChanged"
                        Visibility="{x:Bind local:StatusFormat.VisibleIf(ViewModel.IsRunning), Mode=OneWay}">
                        <ProgressBar
                            Width="120"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Overall sync progress"
                            Maximum="{x:Bind ViewModel.TotalCount, Mode=OneWay}"
                            Value="{x:Bind ViewModel.CompletedCount, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{x:Bind local:StatusFormat.RunProgressText(ViewModel.CompletedCount, ViewModel.TotalCount), Mode=OneWay}" />
                        <Button
                            AutomationProperties.AutomationId="CancelSyncButton"
                            Content="Cancel"
                            ToolTipService.ToolTip="Stop scheduling new repositories; operations already running finish cleanly (Esc)"
                            Command="{x:Bind ViewModel.SyncCancelCommand, Mode=OneTime}">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Escape" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Active strip: exactly the repos cloning/pulling right now, bounded by
                     the parallelism setting, so the table never moves under the user.
                     Three whole rows of chips are visible; beyond that (parallelism up
                     to 64) it scrolls instead of clipping chips to a sliver (#31). -->
                <ScrollViewer
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    MaxHeight="102"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{x:Bind local:StatusFormat.VisibleIf(ViewModel.IsRunning), Mode=OneWay}">
                <ItemsControl
                    x:Name="ActiveStrip"
                    AutomationProperties.Name="Repositories syncing now"
                    ItemsSource="{x:Bind ViewModel.ActiveRepos, Mode=OneTime}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="208" ItemHeight="30" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RepoItemViewModel">
                            <Border
                                Margin="0,0,8,4"
                                Padding="10,4"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="13">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{x:Bind Name, Mode=OneTime}" />
                                    <ProgressBar
                                        Grid.Column="1"
                                        Width="56"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind local:StatusFormat.ProgressAutomationName(Name), Mode=OneTime}"
                                        Maximum="1"
                                        Value="{x:Bind ProgressValue, Mode=OneWay}"
                                        IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>

                <!-- Run results: opens when a run ends, user-dismissable (two-way IsOpen). -->
                <InfoBar
                    Grid.Row="2"
                    AutomationProperties.AutomationId="ResultInfoBar"
                    Margin="0,8,0,0"
                    IsOpen="{x:Bind ViewModel.ResultOpen, Mode=TwoWay}"
                    Severity="{x:Bind local:StatusFormat.SeverityFor(ViewModel.ResultKind), Mode=OneWay}"
                    Title="{x:Bind local:StatusFormat.TitleFor(ViewModel.ResultKind), Mode=OneWay}"
                    Message="{x:Bind ViewModel.ResultMessage, Mode=OneWay}">
                    <StackPanel
                        Margin="0,0,0,12"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Content="Retry failed"
                            Command="{x:Bind ViewModel.RetryFailedCommand, Mode=OneTime}"
                            Visibility="{x:Bind local:StatusFormat.VisibleIf(ViewModel.HasFailedRepos), Mode=OneWay}" />
                        <Button Content="Open folder" Click="OpenFolderButton_Click" />
                    </StackPanel>
                </InfoBar>

                <!-- Repository table: WinUI.TableView (#33). The view model owns sort and
                     filter state - FilteredRepos is the source, already sorted and
                     filtered - so the control's own sorting is intercepted (Sorting /
                     ClearSorting -> SortCommand; the indicator and the header's
                     automation name follow SortColumn from code) and its Excel-style
                     column filters are off in favor of the funnel flyouts in each
                     header, which bind the same view-model filters as before. Selection
                     is model state (the IsSelected column), never the control's. The
                     TableView carries the view model as DataContext so the row-details
                     template's Resolve link can reach ResolvePathsCommand by ElementName. -->
                <local:AccessibleTableView
                    x:Name="RepoTable"
                    AutomationProperties.AutomationId="RepoListView"
                    AutomationProperties.Name="Repositories"
                    Grid.Row="3"
                    Grid.RowSpan="2"
                    Margin="0,8,0,0"
                    DataContext="{x:Bind ViewModel, Mode=OneTime}"
                    ItemsSource="{x:Bind ViewModel.FilteredRepos, Mode=OneTime}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    SelectionMode="None"
                    CornerButtonMode="None"
                    HeadersVisibility="Columns"
                    CanFilterColumns="False"
                    CanSortColumns="True"
                    CanReorderColumns="False"
                    CanResizeColumns="True"
                    ShowExportOptions="False"
                    GridLinesVisibility="Horizontal"
                    HeaderGridLinesVisibility="Horizontal"
                    RowDetailsVisibilityMode="Visible"
                    Sorting="RepoTable_Sorting"
                    ClearSorting="RepoTable_ClearSorting"
                    Loaded="RepoTable_Loaded">
                    <tv:TableView.Columns>

                        <!-- Select: header checkbox acts on the VISIBLE rows (AllSelected). -->
                        <tv:TableViewTemplateColumn
                            Tag="Select"
                            Width="{StaticResource SelectColumnWidth}"
                            CanSort="False"
                            CanResize="False"
                            HeaderStyle="{StaticResource SelectHeaderStyle}">
                            <tv:TableViewTemplateColumn.Header>
                                <CheckBox
                                    MinWidth="0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Select or clear every visible row (hidden rows keep their selection)"
                                    AutomationProperties.Name="Select all visible repositories"
                                    IsChecked="{x:Bind ViewModel.AllSelected, Mode=TwoWay}" />
                            </tv:TableViewTemplateColumn.Header>
                            <tv:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:RepoItemViewModel">
                                    <CheckBox
                                        MinWidth="0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind Name, Mode=OneTime}"
                                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </tv:TableViewTemplateColumn.CellTemplate>
                        </tv:TableViewTemplateColumn>

                        <!-- Name -->
                        <tv:TableViewTextColumn
                            Tag="Name"
                            Width="{StaticResource NameColumnWidth}"
                            MinWidth="140"
                            Binding="{Binding Name, Mode=OneWay}"
                            HeaderStyle="{StaticResource NameHeaderStyle}">
                            <tv:TableViewTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </tv:TableViewTextColumn.ElementStyle>
                            <tv:TableViewTextColumn.Header>
                                <local:ColumnHeaderContent Title="Name">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Name" />
                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource ColumnFilterButtonStyle}"
                                        AutomationProperties.AutomationId="NameFilterButton"
                                        AutomationProperties.Name="{x:Bind TextFilterAutomationName('name', ViewModel.NameFilter), Mode=OneWay}"
                                        ToolTipService.ToolTip="Filter by name">
                                        <FontIcon
                                            FontSize="12"
                                            Glyph="&#xE71C;"
                                            Foreground="{x:Bind TextFilterIndicatorBrush(ViewModel.NameFilter), Mode=OneWay}" />
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom">
                                                <StackPanel Width="220" Spacing="8">
                                                    <TextBox
                                                        Header="Name contains"
                                                        AutomationProperties.AutomationId="NameFilterBox"
                                                        Text="{x:Bind ViewModel.NameFilter, Mode=OneWay}"
                                                        TextChanged="NameFilterBox_TextChanged" />
                                                    <Button
                                                        HorizontalAlignment="Right"
                                                        Content="Clear"
                                                        Click="ClearNameFilter_Click" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </local:ColumnHeaderContent>
                            </tv:TableViewTextColumn.Header>
                        </tv:TableViewTextColumn>

                        <!-- Status: icon + text, plus the row's progress bar while it runs. -->
                        <tv:TableViewTemplateColumn
                            Tag="Status"
                            Width="{StaticResource StatusColumnWidth}"
                            MinWidth="120"
                            CanSort="True"
                            HeaderStyle="{StaticResource StatusHeaderStyle}">
                            <tv:TableViewTemplateColumn.Header>
                                <local:ColumnHeaderContent Title="Status">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Status" />
                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource ColumnFilterButtonStyle}"
                                        AutomationProperties.AutomationId="StatusFilterButton"
                                        AutomationProperties.Name="{x:Bind StatusFilterAutomationName(ViewModel.Filter), Mode=OneWay}"
                                        ToolTipService.ToolTip="Filter by status">
                                        <FontIcon
                                            FontSize="12"
                                            Glyph="&#xE71C;"
                                            Foreground="{x:Bind StatusFilterIndicatorBrush(ViewModel.Filter), Mode=OneWay}" />
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom">
                                                <RadioButtons
                                                    Header="Show"
                                                    AutomationProperties.AutomationId="StatusFilterChoices"
                                                    SelectedIndex="{x:Bind StatusFilterIndex(ViewModel.Filter), Mode=OneWay}"
                                                    SelectionChanged="StatusFilterChoices_SelectionChanged">
                                                    <x:String>All</x:String>
                                                    <x:String>Active</x:String>
                                                    <x:String>Failed</x:String>
                                                    <x:String>Pending</x:String>
                                                </RadioButtons>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </local:ColumnHeaderContent>
                            </tv:TableViewTemplateColumn.Header>
                            <tv:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:RepoItemViewModel">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                FontSize="12"
                                                VerticalAlignment="Center"
                                                Glyph="{x:Bind local:StatusFormat.GlyphFor(Status), Mode=OneWay}"
                                                Foreground="{x:Bind local:StatusFormat.BrushFor(Status), Mode=OneWay}" />
                                            <TextBlock
                                                Text="{x:Bind StatusText, Mode=OneWay}"
                                                Foreground="{x:Bind local:StatusFormat.BrushFor(Status), Mode=OneWay}" />
                                        </StackPanel>
                                        <ProgressBar
                                            Maximum="1"
                                            AutomationProperties.Name="{x:Bind local:StatusFormat.ProgressAutomationName(Name), Mode=OneTime}"
                                            Value="{x:Bind ProgressValue, Mode=OneWay}"
                                            IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                            Visibility="{x:Bind local:StatusFormat.VisibleIf(ShowProgress), Mode=OneWay}" />
                                    </StackPanel>
                                </DataTemplate>
                            </tv:TableViewTemplateColumn.CellTemplate>
                        </tv:TableViewTemplateColumn>

                        <!-- Branch -->
                        <tv:TableViewTextColumn
                            Tag="Branch"
                            Width="{StaticResource BranchColumnWidth}"
                            MinWidth="80"
                            Binding="{Binding BranchText, Mode=OneWay}"
                            HeaderStyle="{StaticResource BranchHeaderStyle}">
                            <tv:TableViewTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Style>
                            </tv:TableViewTextColumn.ElementStyle>
                            <tv:TableViewTextColumn.Header>
                                <local:ColumnHeaderContent Title="Branch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Branch" />
                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource ColumnFilterButtonStyle}"
                                        AutomationProperties.AutomationId="BranchFilterButton"
                                        AutomationProperties.Name="{x:Bind TextFilterAutomationName('branch', ViewModel.BranchFilter), Mode=OneWay}"
                                        ToolTipService.ToolTip="Filter by branch">
                                        <FontIcon
                                            FontSize="12"
                                            Glyph="&#xE71C;"
                                            Foreground="{x:Bind TextFilterIndicatorBrush(ViewModel.BranchFilter), Mode=OneWay}" />
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom">
                                                <StackPanel Width="220" Spacing="8">
                                                    <TextBox
                                                        Header="Branch contains"
                                                        AutomationProperties.AutomationId="BranchFilterBox"
                                                        Text="{x:Bind ViewModel.BranchFilter, Mode=OneWay}"
                                                        TextChanged="BranchFilterBox_TextChanged" />
                                                    <Button
                                                        HorizontalAlignment="Right"
                                                        Content="Clear"
                                                        Click="ClearBranchFilter_Click" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </local:ColumnHeaderContent>
                            </tv:TableViewTextColumn.Header>
                        </tv:TableViewTextColumn>

                        <!-- Archived -->
                        <tv:TableViewTemplateColumn
                            Tag="Archived"
                            Width="{StaticResource ArchivedColumnWidth}"
                            MinWidth="80"
                            CanSort="True"
                            HeaderStyle="{StaticResource ArchivedHeaderStyle}">
                            <tv:TableViewTemplateColumn.Header>
                                <local:ColumnHeaderContent Title="Archived">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Archived" />
                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource ColumnFilterButtonStyle}"
                                        AutomationProperties.AutomationId="ArchivedFilterButton"
                                        AutomationProperties.Name="{x:Bind ArchivedFilterAutomationName(ViewModel.ArchivedFilter), Mode=OneWay}"
                                        ToolTipService.ToolTip="Filter by archived">
                                        <FontIcon
                                            FontSize="12"
                                            Glyph="&#xE71C;"
                                            Foreground="{x:Bind ArchivedFilterIndicatorBrush(ViewModel.ArchivedFilter), Mode=OneWay}" />
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom">
                                                <RadioButtons
                                                    Header="Show"
                                                    AutomationProperties.AutomationId="ArchivedFilterChoices"
                                                    SelectedIndex="{x:Bind ArchivedFilterIndex(ViewModel.ArchivedFilter), Mode=OneWay}"
                                                    SelectionChanged="ArchivedFilterChoices_SelectionChanged">
                                                    <x:String>All</x:String>
                                                    <x:String>Archived only</x:String>
                                                    <x:String>Not archived</x:String>
                                                </RadioButtons>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </local:ColumnHeaderContent>
                            </tv:TableViewTemplateColumn.Header>
                            <tv:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:RepoItemViewModel">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Archived"
                                        Visibility="{x:Bind local:StatusFormat.VisibleIf(IsArchived), Mode=OneTime}" />
                                </DataTemplate>
                            </tv:TableViewTemplateColumn.CellTemplate>
                        </tv:TableViewTemplateColumn>
                    </tv:TableView.Columns>

                    <!-- Row details (always-on mode, collapsed when empty): the failure
                         message, the WSL note, and the Resolve link for Windows-invalid
                         paths - the full-width lines the old row template had under the
                         cells, which a strictly columnar grid cannot host in a cell. -->
                    <tv:TableView.RowDetailsTemplate>
                        <DataTemplate x:DataType="vm:RepoItemViewModel">
                            <StackPanel
                                Padding="52,0,12,6"
                                Spacing="2"
                                Visibility="{x:Bind local:StatusFormat.VisibleIf(HasDetails), Mode=OneWay}">
                                <TextBlock
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind Error, Mode=OneWay}"
                                    Visibility="{x:Bind local:StatusFormat.VisibleIf(HasError), Mode=OneWay}" />
                                <!-- Non-error remark, e.g. where a repository was cloned in WSL (#8). -->
                                <TextBlock
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Note, Mode=OneWay}"
                                    Visibility="{x:Bind local:StatusFormat.VisibleIf(HasNote), Mode=OneWay}" />
                                <HyperlinkButton
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="{x:Bind local:StatusFormat.ResolveAutomationName(Name), Mode=OneTime}"
                                    Content="Resolve…"
                                    Command="{Binding DataContext.ResolvePathsCommand, ElementName=RepoTable}"
                                    CommandParameter="{x:Bind}"
                                    Visibility="{x:Bind local:StatusFormat.VisibleIf(HasPathIssue), Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </tv:TableView.RowDetailsTemplate>
                </local:AccessibleTableView>

                <!-- Shown when the current filter hides everything the table has. -->
                <TextBlock
                    x:Name="EmptyFilterText"
                    Grid.Row="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No repositories match this filter."
                    Visibility="Collapsed" />

                <!-- Shown when a load succeeded but returned nothing: a wrong name, an
                     empty org, or a token that cannot see its repositories all list as
                     empty rather than failing, and a blank table explains none of them. -->
                <TextBlock
                    x:Name="EmptyTableText"
                    AutomationProperties.AutomationId="EmptyTableText"
                    Grid.Row="4"
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- Load-phase status and the page's assistive-technology live region. Kept in
             the tree (with its name) so announcements keep working in both states. -->
        <TextBlock
            x:Name="StatusTextBlock"
            AutomationProperties.AutomationId="StatusTextBlock"
            Grid.Row="2"
            AutomationProperties.LiveSetting="Polite"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
