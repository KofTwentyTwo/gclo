<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="gclo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:gclo"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="gclo">

    <!-- The backdrop is chosen in code: Mica where supported (Windows 11), acrylic
         where only that is, and a plain themed background on the Windows 10 floor the
         app claims to support — a declared MicaBackdrop is silently ignored there and
         the semi-transparent card brushes would sit on an unthemed surface (#31). -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File" AccessKey="F">
                <MenuFlyoutItem Text="Settings…" AccessKey="S" AutomationProperties.AutomationId="MenuSettings" Click="SettingsMenuItem_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" AccessKey="X" AutomationProperties.AutomationId="MenuExit" Click="ExitMenuItem_Click" />
            </MenuBarItem>
            <MenuBarItem Title="View" AccessKey="V">
                <MenuFlyoutItem Text="Activity log…" AccessKey="A" AutomationProperties.AutomationId="MenuActivityLog" Click="ActivityLogMenuItem_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Help" AccessKey="H">
                <MenuFlyoutItem Text="View the project page" AccessKey="P" AutomationProperties.AutomationId="MenuProjectPage" ToolTipService.ToolTip="Open gclo's home on git.kof22.com" Click="ProjectPageMenuItem_Click" />
                <MenuFlyoutItem Text="Submit an issue…" AccessKey="I" AutomationProperties.AutomationId="MenuSubmitIssue" ToolTipService.ToolTip="Report a bug or request a feature in the project's issue tracker" Click="SubmitIssueMenuItem_Click" />
                <MenuFlyoutItem Text="Community support…" AccessKey="S" AutomationProperties.AutomationId="MenuCommunitySupport" ToolTipService.ToolTip="Ask a question, or see what others asked, in the project's issue tracker" Click="CommunitySupportMenuItem_Click" />
                <MenuFlyoutItem Text="Share gclo by email…" AccessKey="E" AutomationProperties.AutomationId="MenuShare" ToolTipService.ToolTip="Draft an invitation with download links in your email program" Click="ShareMenuItem_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="CheckUpdatesMenuItem" Text="Check for updates…" AccessKey="C" AutomationProperties.AutomationId="MenuCheckUpdates" Click="CheckForUpdatesMenuItem_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="About gclo…" AccessKey="A" AutomationProperties.AutomationId="MenuAbout" Click="AboutMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F1" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
        </MenuBar>

        <!-- Update flow surface (#39): checking / downloading with a progress bar, and
             the up-to-date / failure outcomes inline, instead of a silent wait followed by
             a modal. Only the "update available" decision still uses a dialog. -->
        <InfoBar
            x:Name="UpdateBar"
            AutomationProperties.AutomationId="UpdateBar"
            Grid.Row="1"
            Margin="12,8,12,0"
            IsClosable="True"
            Title="Updates">
            <ProgressBar
                x:Name="UpdateProgressBar"
                Margin="0,0,0,8"
                Maximum="100"
                Visibility="Collapsed" />
        </InfoBar>

        <!-- Workspace shell: Quick Sync is pinned first; one item per saved account is
             added below the separator in code-behind (the store is runtime data).
             Content hosts the selected workspace's cached WorkspacePage. -->
        <NavigationView
            x:Name="WorkspaceNav"
            AutomationProperties.AutomationId="WorkspaceNav"
            Grid.Row="2"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="240"
            SelectionChanged="WorkspaceNav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="QuickSyncNavItem"
                    AutomationProperties.AutomationId="NavQuickSync"
                    Content="Quick Sync"
                    ToolTipService.ToolTip="Ad-hoc sync: paste a token and go, nothing is saved">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="SyncAllNavItem"
                    AutomationProperties.AutomationId="NavSyncAll"
                    Content="Sync all"
                    ToolTipService.ToolTip="Run every saved account in order, one after another"
                    Tag="syncall"
                    IsEnabled="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.AutomationId="NavAddAccount"
                    Content="Add account"
                    ToolTipService.ToolTip="Save an organization, token, and target as a reusable account"
                    Tag="add">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Sync all (#167): one row above the workspace, there for the whole pass
                     whichever workspace is on screen - which account, which of how many,
                     how far along - laid out like the workspace's own toolbar (progress
                     and Cancel on the right) and on the same left and right edges as the
                     workspace's cards. Afterwards it holds the result until it is closed.
                     Filled from SyncAllStatus in code-behind. -->
                <Grid
                    x:Name="SyncAllBar"
                    Grid.Row="0"
                    Margin="20,20,20,0"
                    MinHeight="48"
                    Padding="12,8,12,8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        x:Name="SyncAllIcon"
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        FontSize="16"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Glyph="&#xE895;" />
                    <TextBlock
                        x:Name="SyncAllTitleText"
                        Grid.Column="1"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="SyncAllTitle"
                        AutomationProperties.LiveSetting="Polite"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="SyncAllMessageText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="SyncAllMessage"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <!-- A StackPanel, so a hidden control leaves no gap behind. -->
                    <StackPanel
                        Grid.Column="3"
                        Margin="12,0,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <ProgressBar
                            x:Name="SyncAllProgressBar"
                            Width="100"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Progress of the account that is syncing"
                            Maximum="1" />
                        <Button
                            x:Name="SyncAllShowAccountButton"
                            AutomationProperties.AutomationId="SyncAllShowAccount"
                            Content="Show account"
                            ToolTipService.ToolTip="Go to the account that is syncing now"
                            Click="SyncAllShowAccount_Click" />
                        <Button
                            x:Name="SyncAllCancelButton"
                            AutomationProperties.AutomationId="SyncAllCancel"
                            Content="Cancel sync all"
                            ToolTipService.ToolTip="Stop after the account that is syncing now"
                            Click="SyncAllCancel_Click" />
                        <Button
                            x:Name="SyncAllCloseButton"
                            Width="32"
                            Height="32"
                            Padding="0"
                            AutomationProperties.AutomationId="SyncAllClose"
                            AutomationProperties.Name="Close"
                            ToolTipService.ToolTip="Close"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="SyncAllClose_Click">
                            <FontIcon FontSize="10" Glyph="&#xE8BB;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- The selected workspace's page, set from code-behind. -->
                <ContentPresenter x:Name="WorkspaceHost" Grid.Row="1" />
            </Grid>
        </NavigationView>

        <!-- Branded startup splash: covers the whole window until MainWindow dismisses
             it (fade + removal). An overlay, not a second Window — see SplashOverlay. -->
        <local:SplashOverlay
            x:Name="StartupSplash"
            Grid.Row="0"
            Grid.RowSpan="3" />
    </Grid>
</Window>
