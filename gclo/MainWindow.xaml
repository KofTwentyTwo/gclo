<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="gclo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:gclo"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="gclo">

    <!-- The backdrop is chosen in code: Mica where supported (Windows 11), acrylic
         where only that is, and a plain themed background on the Windows 10 floor the
         app claims to support — a declared MicaBackdrop is silently ignored there and
         the semi-transparent card brushes would sit on an unthemed surface (#31). -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File" AccessKey="F">
                <MenuFlyoutItem Text="Settings…" AccessKey="S" AutomationProperties.AutomationId="MenuSettings" Click="SettingsMenuItem_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" AccessKey="X" AutomationProperties.AutomationId="MenuExit" Click="ExitMenuItem_Click" />
            </MenuBarItem>
            <MenuBarItem Title="View" AccessKey="V">
                <MenuFlyoutItem Text="Activity log…" AccessKey="A" AutomationProperties.AutomationId="MenuActivityLog" Click="ActivityLogMenuItem_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Help" AccessKey="H">
                <MenuFlyoutItem Text="View on GitHub" AccessKey="G" AutomationProperties.AutomationId="MenuGitHub" Click="GitHubMenuItem_Click" />
                <MenuFlyoutItem Text="Submit an issue…" AccessKey="I" AutomationProperties.AutomationId="MenuSubmitIssue" ToolTipService.ToolTip="Report a bug or request a feature on GitHub" Click="SubmitIssueMenuItem_Click" />
                <MenuFlyoutItem Text="Community support…" AccessKey="S" AutomationProperties.AutomationId="MenuCommunitySupport" ToolTipService.ToolTip="Ask a question or share tips in GitHub Discussions" Click="CommunitySupportMenuItem_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="CheckUpdatesMenuItem" Text="Check for updates…" AccessKey="C" AutomationProperties.AutomationId="MenuCheckUpdates" Click="CheckForUpdatesMenuItem_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="About gclo…" AccessKey="A" AutomationProperties.AutomationId="MenuAbout" Click="AboutMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F1" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
        </MenuBar>

        <!-- Update flow surface (#39): checking / downloading with a progress bar, and
             the up-to-date / failure outcomes inline, instead of a silent wait followed by
             a modal. Only the "update available" decision still uses a dialog. -->
        <InfoBar
            x:Name="UpdateBar"
            AutomationProperties.AutomationId="UpdateBar"
            Grid.Row="1"
            Margin="12,8,12,0"
            IsClosable="True"
            Title="Updates">
            <ProgressBar
                x:Name="UpdateProgressBar"
                Margin="0,0,0,8"
                Maximum="100"
                Visibility="Collapsed" />
        </InfoBar>

        <!-- Workspace shell: Quick Sync is pinned first; one item per saved account is
             added below the separator in code-behind (the store is runtime data).
             Content hosts the selected workspace's cached WorkspacePage. -->
        <NavigationView
            x:Name="WorkspaceNav"
            AutomationProperties.AutomationId="WorkspaceNav"
            Grid.Row="2"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="240"
            SelectionChanged="WorkspaceNav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="QuickSyncNavItem"
                    AutomationProperties.AutomationId="NavQuickSync"
                    Content="Quick Sync"
                    ToolTipService.ToolTip="Ad-hoc sync: paste a token and go, nothing is saved">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="SyncAllNavItem"
                    AutomationProperties.AutomationId="NavSyncAll"
                    Content="Sync all"
                    ToolTipService.ToolTip="Run every saved account in order, one after another"
                    Tag="syncall"
                    IsEnabled="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.AutomationId="NavAddAccount"
                    Content="Add account"
                    ToolTipService.ToolTip="Save an organization, token, and target as a reusable account"
                    Tag="add">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
        </NavigationView>

        <!-- Branded startup splash: covers the whole window until MainWindow dismisses
             it (fade + removal). An overlay, not a second Window — see SplashOverlay. -->
        <local:SplashOverlay
            x:Name="StartupSplash"
            Grid.Row="0"
            Grid.RowSpan="3" />
    </Grid>
</Window>
