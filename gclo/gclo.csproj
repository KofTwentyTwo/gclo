<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>gclo</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Brand\gclo.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Velopack must run before any XAML starts, so the app supplies its own Main (Program.cs). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- MSIX tile assets: the full standard scale/targetsize set (transparent PNGs).
         Packaged via the manifest for MSIX builds. -->
    <Content Include="Assets\**\*.png" />
    <!-- True-vector mark: the window title-bar icon (.ico, loaded from the app
         directory by AppWindow.SetIcon) and the SVG the splash and About render via
         SvgImageSource (ms-appx:///). CopyToOutputDirectory is required so these reach
         BOTH the build output AND `dotnet publish` output — the unpackaged Velopack
         build has no MSIX packaging step to carry them otherwise. -->
    <Content Include="Assets\Brand\gclo-icon.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Brand\gclo.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Released artifacts carry the license (K22-REPO-01). -->
    <Content Include="..\LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="WinUI.TableView" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\gclo.Engine\gclo.Engine.csproj" />
    <ProjectReference Include="..\gclo.ViewModels\gclo.ViewModels.csproj" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--
    Publish-only properties. A plain Release build must not depend on the ReadyToRun
    (crossgen) and trimming packs: only a publish-time restore downloads them, and the
    release workflow restores once without a configuration, then builds Release
    (NETSDK1094 otherwise). `_IsPublishing` is set by `dotnet publish`.
  -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true' And '$(Configuration)' != 'Debug'">
    <PublishReadyToRun>True</PublishReadyToRun>
    <PublishTrimmed>True</PublishTrimmed>
  </PropertyGroup>
</Project>