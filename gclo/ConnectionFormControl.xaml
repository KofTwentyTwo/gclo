<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="gclo.ConnectionFormControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:gclo"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="False"
    Loaded="OnLoaded">

    <!-- The one connection form: for Quick Sync the place (GitHub, or Gitea and the
         server's address), then token, organization, target folder, subfolder
         preference, and the path preview. Hosted by the connect card and by the
         chip's Edit flyout (WorkspacePage), both over the same view model, so a
         change here lands in both places and the FlaUI suite can target either
         through its AutomationIdPrefix. -->
    <StackPanel Spacing="12">
        <!-- Where the repositories are (#209). First on the form: the token below is
             for this place. Asked on Quick Sync only; an account's place is fixed,
             and its page says where it is in its title. -->
        <RadioButtons
            x:Name="PlaceChoice"
            AutomationProperties.AutomationId="{x:Bind Id('PlaceChoice')}"
            Header="Where are the repositories?"
            MaxColumns="2"
            SelectedIndex="{x:Bind ViewModel.PlaceIndex, Mode=TwoWay}"
            Visibility="{x:Bind local:StatusFormat.VisibleIf(ViewModel.CanChoosePlace), Mode=OneWay}">
            <RadioButton AutomationProperties.AutomationId="{x:Bind Id('PlaceGitHub')}" Content="GitHub" />
            <RadioButton AutomationProperties.AutomationId="{x:Bind Id('PlaceGitea')}" Content="Gitea" />
        </RadioButtons>
        <!-- Taken when the box is left (or Enter is pressed), never while it is
             typed: no token is sent to half an address. -->
        <TextBox
            x:Name="ServerBox"
            AutomationProperties.AutomationId="{x:Bind Id('ServerBox')}"
            Header="Server address"
            ToolTipService.ToolTip="The address of the Gitea (or Forgejo) server itself. HTTPS only; the token is sent to this address and nowhere else."
            PlaceholderText="https://git.example.com"
            Text="{x:Bind ViewModel.Server, Mode=OneWay}"
            LostFocus="ServerBox_LostFocus"
            KeyDown="ServerBox_KeyDown"
            Visibility="{x:Bind local:StatusFormat.VisibleIf(ViewModel.AsksForServer), Mode=OneWay}" />
        <TextBlock
            x:Name="ServerErrorText"
            AutomationProperties.AutomationId="{x:Bind Id('ServerError')}"
            AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Text="{x:Bind ViewModel.ServerError, Mode=OneWay}"
            Visibility="{x:Bind local:StatusFormat.VisibleIfNotEmpty(ViewModel.ServerError), Mode=OneWay}" />
        <PasswordBox
            x:Name="TokenBox"
            AutomationProperties.AutomationId="{x:Bind Id('TokenBox')}"
            Header="Personal access token"
            ToolTipService.ToolTip="Needs read access to repositories. Never written to disk or logs."
            PlaceholderText="ghp_…"
            PasswordChanged="TokenBox_PasswordChanged" />
        <HyperlinkButton
            x:Name="TokenPageLink"
            Padding="0"
            Content="How to create a token"
            NavigateUri="https://github.com/settings/tokens" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                Grid.Column="0"
                AutomationProperties.AutomationId="{x:Bind Id('OrgBox')}"
                HorizontalAlignment="Stretch"
                Header="Organization or account"
                x:Name="OrgBox"
                ToolTipService.ToolTip="The organization or user account whose repositories are synced. Type its name, or list the ones the token can see."
                IsEditable="True"
                ItemsSource="{x:Bind ViewModel.Organizations, Mode=OneTime}"
                PlaceholderText="Type a name, or press Find to list them"
                Loaded="OrgBox_Loaded"
                Text="{x:Bind ViewModel.Organization, Mode=TwoWay}" />
            <!-- Quick Sync sends a token nowhere by itself (#209): the list of
                 organizations is fetched when this is pressed. An account's page
                 lists them when it opens; its token was saved for its place. -->
            <Button
                Grid.Column="1"
                AutomationProperties.AutomationId="{x:Bind Id('FindOrgsButton')}"
                VerticalAlignment="Bottom"
                Content="Find"
                ToolTipService.ToolTip="Lists the organizations the token can see. Pressing this sends the token to the place chosen above; nothing is sent before."
                Command="{x:Bind ViewModel.FindOrganizationsCommand, Mode=OneWay}"
                Visibility="{x:Bind local:StatusFormat.VisibleIf(ViewModel.CanChoosePlace), Mode=OneWay}" />
            <ProgressRing
                Grid.Column="2"
                Width="20"
                Height="20"
                Margin="0,0,0,8"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="Loading organizations"
                IsActive="{x:Bind ViewModel.IsLoadingOrgs, Mode=OneWay}" />
        </Grid>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="0"
                AutomationProperties.AutomationId="{x:Bind Id('TargetBox')}"
                ToolTipService.ToolTip="Local folder each repository is cloned into (one subfolder per repository)"
                Header="Target folder"
                PlaceholderText="C:\src\my-org"
                Text="{x:Bind ViewModel.TargetFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="1"
                AutomationProperties.AutomationId="{x:Bind Id('BrowseButton')}"
                ToolTipService.ToolTip="Choose the target folder"
                VerticalAlignment="Bottom"
                Content="Browse…"
                Click="BrowseButton_Click" />
        </Grid>
        <CheckBox
            MinWidth="0"
            Content="{x:Bind OrgSubfolderLabel(ViewModel.Organization), Mode=OneWay}"
            IsChecked="{x:Bind ViewModel.CreateOrgSubfolder, Mode=TwoWay}" />
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Visibility="{x:Bind local:StatusFormat.VisibleIfNotEmpty(ViewModel.TargetPreview), Mode=OneWay}">
            <Run Text="Each repository will be placed at:" />
            <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.TargetPreview, Mode=OneWay}" />
        </TextBlock>
    </StackPanel>
</UserControl>
