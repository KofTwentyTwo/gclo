<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The release publishes win-x64; declaring it keeps that runtime graph in
         packages.lock.json so the publish can restore in locked mode. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Always on, so the lock file matches the single-file release publish (see gclo.Engine.csproj). -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>gclo</AssemblyName>
    <RootNamespace>gclo.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>..\gclo\Assets\Brand\gclo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\gclo.Engine\gclo.Engine.csproj" />
    <ProjectReference Include="..\gclo.ViewModels\gclo.ViewModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test suite drives internal command cores with injected collaborators. -->
    <InternalsVisibleTo Include="gclo.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Released artifacts carry the license (K22-REPO-01); kept beside the single-file exe. -->
    <Content Include="..\LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
