<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Keeps the restore graph identical between a plain build and the release publish
      (runtime win-x64, self-contained, single file), so the lock files pass
      locked mode in both: the RID graph is always present, and the single-file
      analyzer (which pulls Microsoft.NET.ILLink.Tasks) is always on.
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Core engine for gclo (Git Clone Large Organizations): lists every repository in a GitHub organization or user account and clones or fast-forward-pulls them all in parallel, with Windows path validation and rename/skip recovery.</Description>
    <Authors>James Maes</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/KofTwentyTwo/gclo</RepositoryUrl>
    <PackageProjectUrl>https://github.com/KofTwentyTwo/gclo</PackageProjectUrl>
    <PackageTags>github;git;clone;mirror;organization;libgit2sharp;octokit</PackageTags>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <!-- Publish-quality package: SourceLink to the public repo, symbols in a
         .snupkg, untracked (generated) sources embedded so step-through works. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test suite fakes the internal GitHub gateway seam. -->
    <InternalsVisibleTo Include="gclo.Engine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibGit2Sharp" />
    <PackageReference Include="Octokit" />
  </ItemGroup>

</Project>
