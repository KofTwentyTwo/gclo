<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\gclo.Engine\gclo.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      Keeps the restore graph identical between a plain build and the release publish
      (runtime win-x64, self-contained, single file), so the lock files pass
      locked mode in both: the RID graph is always present, and the single-file
      analyzer (which pulls Microsoft.NET.ILLink.Tasks) is always on.
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test suite exercises internal seams (vault error arms). -->
    <InternalsVisibleTo Include="gclo.Engine.Tests" />
  </ItemGroup>

</Project>
