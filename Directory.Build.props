<Project>

  <!-- KofTwentyTwo .NET quality gate (standards: K22-CODE-CS), from
       KofTwentyTwo/standards configs/dotnet/Directory.Build.props. Every rule fails
       `dotnet build` locally exactly as it fails in CI. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Warnings are errors; analyzers and .editorconfig style run in every build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required for IDE0005 (unused usings) to run during build. CS1591 (missing XML
         doc) stays on for packable projects and is silenced for everything else below. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Reproducible builds with source-linked symbols. -->
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Supply chain: audit direct AND transitive packages; pin the whole graph. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- CI: normalized paths, and restore must match the committed lock files exactly. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>

  <!-- Only shipped libraries must document their public API. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'true'">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Repository-wide analyzers; versions live in Directory.Packages.props. -->
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>

  <!-- Single version source. Local builds are <prefix>-dev; release builds pass an
       explicit -p:Version=<tag-version>, which overrides both parts. The SDK's
       built-in SourceLink appends the git commit as "+<sha>" build metadata on
       AssemblyInformationalVersion, which the About dialog and the CLI's
       version output surface as the short hash. Prefix tracks the next expected
       release after the last stable tag (v1.0.0). -->
  <PropertyGroup>
    <VersionPrefix>1.0.1</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
  </PropertyGroup>

</Project>
